---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/selector-quest.css';

// tab=style.css opens the CSS file first (the 2.0 editor's sharing parameter, checked October 27).
const codepenEmbedUrl = 'https://codepen.io/editor/tmasingale/pen/019dd4c7-6216-7eaa-8caf-d056f6e6f77f?tab=style.css&default-tab=css,result&editable=true';
const codepenPenUrl = 'https://codepen.io/editor/tmasingale/pen/019dd4c7-6216-7eaa-8caf-d056f6e6f77f';

const helpLinks = {
  basic: 'https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Styling_basics/Basic_selectors',
  descendant: 'https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors/Descendant_combinator',
  classSelectors: 'https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors/Class_selectors',
  pseudoClasses: 'https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors/Pseudo-classes',
  hover: 'https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors/:hover',
  focus: 'https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors/:focus',
  visited: 'https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors/:visited',
  figure: 'https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/figure',
  figcaption: 'https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/figcaption',
  blockquote: 'https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/blockquote',
  cite: 'https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/cite',
  boxModel: 'https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Styling_basics/Box_model',
  selectorsReference: 'https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors',
};

function formatPropertyList(properties: string[]) {
  if (properties.length === 1) return properties;
  if (properties.length === 2) return [properties[0], ' and ', properties[1]];
  return properties.flatMap((property, index) => {
    if (index === 0) return [property];
    if (index === properties.length - 1) return [', and ', property];
    return [', ', property];
  });
}

const chapters = [
  {
    number: 1,
    title: 'Chapter 1: The City of Markup',
    subtitle: 'Type selectors and a descendant selector',
    story: 'In Markup, every building has a tag name. The grand tower is an h1. The chapter signs are h2 elements. The ordinary citizens are paragraphs, moving through the page with quiet structure. Your first job is to teach CSS how to recognize them.',
    selectorMap: [
      ['h1', 'Finds the main page title.'],
      ['h2', 'Finds each chapter heading.'],
      ['.bio p', 'Finds paragraphs only when they live inside the bio section.'],
    ],
    help: [
      ['Basic selectors', helpLinks.basic],
      ['Descendant selector', helpLinks.descendant],
    ],
    missions: [
      {
        selector: 'h1',
        properties: ['color', 'font-size', 'text-align'],
        guidance: 'Choose a title color, make the title noticeably larger than the body text, and decide how it should align.',
      },
      {
        selector: 'h2',
        properties: ['color'],
        guidance: 'Choose a chapter-heading color that stands apart from regular paragraph text.',
      },
      {
        selector: '.bio p',
        properties: ['line-height'],
        guidance: 'Choose a line height that makes the story paragraphs easier to read.',
      },
    ],
    open: true,
  },
  {
    number: 2,
    title: 'Chapter 2: The Portrait of the Selector',
    subtitle: 'Semantic media elements and image styling',
    story: 'The Selector Guild keeps a portrait in the archive. The image and its caption belong together, so the figure needs to behave like a single exhibit piece.',
    selectorMap: [
      ['figure', 'Finds the full image-and-caption group.'],
      ['figure img', 'Finds only images inside a figure.'],
      ['figcaption', 'Finds the caption text attached to the figure.'],
    ],
    help: [
      ['figure', helpLinks.figure],
      ['figcaption', helpLinks.figcaption],
      ['Descendant selector', helpLinks.descendant],
    ],
    missions: [
      {
        selector: 'figure',
        properties: ['margin'],
        guidance: 'Use margin to create space around the whole image-and-caption group and help it feel intentionally placed.',
      },
      {
        selector: 'figure img',
        properties: ['width', 'border'],
        guidance: 'Use width to control how large the image appears, then add a visible frame with border.',
      },
      {
        selector: 'figcaption',
        properties: ['text-align', 'font-style', 'padding-top', 'color'],
        guidance: 'Align the caption, make it feel like caption text, add a little space above it, and choose a quieter color.',
      },
    ],
  },
  {
    number: 3,
    title: 'Chapter 3: The Link Portals',
    subtitle: 'Pseudo-classes for link states',
    story: 'In Markup, links are portals. Some have never been opened. Some have already been visited. Some glow when hovered, focused, or pressed. Pseudo-classes let CSS detect those moments.',
    selectorMap: [
      ['a:link', 'Finds links that have not been visited.'],
      ['a:visited', 'Finds links the browser recognizes as visited.'],
      ['a:focus', 'Finds a link selected by keyboard or click focus.'],
      ['a:hover', 'Finds a link while the pointer is over it.'],
      ['a:active', 'Finds a link while it is being activated.'],
    ],
    help: [
      ['Pseudo-classes', helpLinks.pseudoClasses],
      [':hover', helpLinks.hover],
      [':focus', helpLinks.focus],
      [':visited', helpLinks.visited],
    ],
    missions: [
      {
        selector: 'a:link',
        properties: ['color', 'text-decoration'],
        guidance: 'Choose how unvisited links should look before anyone opens them.',
      },
      {
        selector: 'a:visited',
        properties: ['color'],
        guidance: 'Choose a different color for links the browser recognizes as visited.',
      },
      {
        selector: 'a:focus',
        properties: ['outline', 'background'],
        guidance: 'Make keyboard focus easy to see when a link is selected.',
      },
      {
        selector: 'a:hover',
        properties: ['color', 'text-decoration'],
        guidance: 'Make the link visibly respond when the pointer is over it.',
      },
      {
        selector: 'a:active',
        properties: ['color'],
        guidance: 'Choose a color for the moment the link is being pressed or activated.',
      },
    ],
  },
  {
    number: 4,
    title: 'Chapter 4: The Timeline Trail',
    subtitle: 'Class selector plus descendant list items',
    story: 'The Guild records its discoveries on a timeline. A normal list is too plain for this trail, so CSS must find the timeline and then find only the list items inside it.',
    selectorMap: [
      ['.timeline', 'Finds the list with the class name timeline.'],
      ['.timeline li', 'Finds list items only when they are inside the timeline.'],
    ],
    help: [
      ['Class selectors', helpLinks.classSelectors],
      ['Descendant selector', helpLinks.descendant],
    ],
    missions: [
      {
        selector: '.timeline',
        properties: ['list-style'],
        guidance: 'Change the default bullets so the list can become a custom timeline.',
      },
      {
        selector: '.timeline li',
        properties: ['border-left', 'padding-left', 'margin-bottom'],
        guidance: 'Use these properties to create a vertical trail, move text away from the trail line, and separate each item.',
      },
    ],
  },
  {
    number: 5,
    title: 'Chapter 5: The Quotation Chamber',
    subtitle: 'Pull quote styling and a nested cite selector',
    story: 'The oldest rule in the Guild is written as a quotation. It should sound different from the surrounding text. The citation should be quieter than the quote itself.',
    selectorMap: [
      ['blockquote', 'Finds the full quotation block.'],
      ['blockquote cite', 'Finds the citation only when it appears inside a blockquote.'],
    ],
    help: [
      ['blockquote', helpLinks.blockquote],
      ['cite', helpLinks.cite],
      ['Descendant selector', helpLinks.descendant],
    ],
    missions: [
      {
        selector: 'blockquote',
        properties: ['font-size', 'font-style', 'color', 'border-left', 'padding', 'margin'],
        guidance: 'Make the quote feel different from paragraph text, give it a visual edge, and add breathing room around it.',
      },
      {
        selector: 'blockquote cite',
        properties: ['font-size', 'color', 'font-style'],
        guidance: 'Make the citation smaller and quieter than the quotation itself.',
      },
    ],
  },
  {
    number: 6,
    title: 'Chapter 6: The Box Model Castle',
    subtitle: 'Semantic layout selectors and spacing',
    story: 'The final lesson takes place inside the Box Model Castle. Every room has content, padding, border, and margin. Use semantic selectors to make those spaces visible.',
    selectorMap: [
      ['section', 'Finds each major content room.'],
      ['header', 'Finds the opening banner area.'],
      ['main', 'Finds the main content wrapper.'],
    ],
    help: [
      ['Box model', helpLinks.boxModel],
      ['Full selectors reference', helpLinks.selectorsReference],
    ],
    missions: [
      {
        selector: 'section',
        properties: ['background-color', 'margin-bottom', 'border', 'padding'],
        guidance: 'Make each section visibly separate while exploring outside space, edges, and inside space.',
      },
      {
        selector: 'header',
        properties: ['padding', 'background'],
        guidance: 'Give the opening area deliberate inside space and a background treatment.',
      },
      {
        selector: 'main',
        properties: ['padding'],
        guidance: 'Add inside space around the main content area.',
      },
    ],
  },
];

const spellbookRows = [
  ['Type selector', 'h1', 'Finds every matching HTML element.'],
  ['Class selector', '.timeline', 'Finds every element with that class name.'],
  ['Descendant selector', '.bio p', 'Finds matching elements nested inside another selector.'],
  ['Pseudo-class', 'a:hover', 'Finds an element in a specific state or interaction moment.'],
];
---

<BaseLayout title="CSS Selector Quest: The Selector Guild - DESN368" workspaceMode={true}>
  <main class="selector-quest" aria-labelledby="sq-page-title" data-view="both">
    <div class="selector-quest__toolbar">
      <span class="selector-quest__toolbar-label" id="sq-layout-label">Layout</span>
      <div class="selector-quest__views" role="group" aria-labelledby="sq-layout-label">
        <button type="button" data-view="story" aria-pressed="false">Story</button>
        <button type="button" data-view="both" aria-pressed="true">Both</button>
        <button type="button" data-view="pen" aria-pressed="false">Pen</button>
      </div>
      <div class="selector-quest__width" role="group" aria-labelledby="sq-width-label">
        <span class="selector-quest__toolbar-label" id="sq-width-label">Story width</span>
        <button type="button" data-nudge="-1" aria-controls="sq-story" aria-label="Make the story narrower">&minus;</button>
        <button type="button" data-nudge="1" aria-controls="sq-story" aria-label="Make the story wider">+</button>
        <button type="button" data-reset-width aria-controls="sq-story">Reset</button>
      </div>
      <details class="selector-quest__tips">
        <summary>Layout tips</summary>
        <ul tabindex="-1">
          <li><strong>Story, Both, Pen</strong> choose what this page shows. It remembers your choice next time.</li>
          <li><strong>On a wide screen, drag the bar</strong> between the story and the Pen to make either side wider. Or use the <strong>&minus;</strong> and <strong>+</strong> buttons, or click the bar and use the arrow keys. Double-click the bar, or press <strong>Reset</strong>, to go back.</li>
          <li><strong>Inside the Pen,</strong> drag the line between the code and the preview to give either more room. The grid button at the Pen's top right changes CodePen's own layout: editors and preview together, editors only, or preview only, with the editors on the left, top or right.</li>
          <li><strong>Still cramped?</strong> Open the Pen in its own tab and keep this page beside it.</li>
        </ul>
      </details>
      <a class="selector-quest__open" href={codepenPenUrl} target="_blank" rel="noopener noreferrer">
        Open the Pen in a new tab
        <span aria-hidden="true">&#8599;</span>
      </a>
    </div>
    <div class="selector-quest__layout">
      <aside class="selector-quest__story-panel" id="sq-story" aria-label="CSS selector quest instructions">
        <a class="selector-quest__back-link" href="/1/weeks/week-5">&larr; Week 5</a>

        <header class="selector-quest__hero">
          <p class="selector-quest__eyebrow">CSS Selectors</p>
          <h1 id="sq-page-title">CSS Selector Quest: The Selector Guild</h1>
          <p class="selector-quest__intro">
            In the city of Markup, every element is waiting to be found. A CSS selector is a search spell: it tells the browser exactly which parts of the page should change. Complete each chapter by choosing the right selector block, adding CSS declarations, and checking the result in the CodePen.
          </p>
          <p class="selector-quest__match">
            <strong>Style it to match the portrait.</strong> The picture in Chapter 2 sets the look: royal purple, gold, sky blue, parchment and stone, with storybook serif lettering. Take your colors from it, choose fonts that feel like its lettering, and keep its storybook mood in every chapter.
          </p>
        </header>

        <section class="selector-quest__chapters" aria-label="Selector Guild story chapters">
          {chapters.map((chapter) => (
            <details class="selector-quest__chapter" open={chapter.open}>
              <summary>
                <span class="selector-quest__chapter-number">{chapter.number}</span>
                <span class="selector-quest__chapter-heading">
                  <span class="selector-quest__chapter-title">{chapter.title}</span>
                  <span class="selector-quest__chapter-subtitle">{chapter.subtitle}</span>
                </span>
              </summary>

              <div class="selector-quest__chapter-content">
                <p class="selector-quest__story">{chapter.story}</p>

                <h2>Selector Map</h2>
                <dl class="selector-quest__selector-map">
                  {chapter.selectorMap.map(([selector, description]) => (
                    <div>
                      <dt><code>{selector}</code></dt>
                      <dd>{description}</dd>
                    </div>
                  ))}
                </dl>

                <h2>Mission</h2>
                <ul class="selector-quest__mission-list">
                  {chapter.missions.map((mission) => (
                    <li>
                      In the <code>{mission.selector}</code> rule, type{' '}
                      {formatPropertyList(mission.properties).map((part) => (
                        mission.properties.includes(part) ? <code>{part}</code> : part
                      ))}
                      . {mission.guidance}
                    </li>
                  ))}
                </ul>

                <p class="selector-quest__hint-note">
                  Find this selector block in the CSS panel and complete the missing declarations.
                </p>

                <h2>Help Links</h2>
                <ul class="selector-quest__help-links">
                  {chapter.help.map(([label, url]) => (
                    <li>
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        {label}
                        <span aria-hidden="true">&#8599;</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))}
        </section>

        <section class="selector-quest__spellbook" aria-labelledby="sq-spellbook-title">
          <h2 id="sq-spellbook-title">Selector Spellbook</h2>
          <table>
            <thead>
              <tr>
                <th scope="col">Selector Type</th>
                <th scope="col">Example</th>
                <th scope="col">What It Finds</th>
              </tr>
            </thead>
            <tbody>
              {spellbookRows.map(([type, example, description]) => (
                <tr>
                  <td>{type}</td>
                  <td><code>{example}</code></td>
                  <td>{description}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p>
            <a href={helpLinks.selectorsReference} target="_blank" rel="noopener noreferrer">
              Open the full MDN selectors reference
              <span aria-hidden="true">&#8599;</span>
            </a>
          </p>
        </section>
      </aside>

      <div
        class="selector-quest__divider"
        role="separator"
        tabindex="0"
        aria-orientation="vertical"
        aria-controls="sq-story"
        aria-label="Resize the story panel"
        title="Drag to resize. Double-click to reset."
      ></div>

      <section class="selector-quest__pen-panel" aria-label="CodePen practice area">
        <iframe
          title="CSS Selector Quest CodePen"
          src={codepenEmbedUrl}
          loading="lazy"
          allowfullscreen>
        </iframe>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  // Layout controls: Story / Both / Pen, a draggable divider, and a remembered choice (Travis, October 27).
  const root = document.querySelector<HTMLElement>('.selector-quest');
  const layout = root?.querySelector<HTMLElement>('.selector-quest__layout');
  const story = root?.querySelector<HTMLElement>('.selector-quest__story-panel');
  const divider = root?.querySelector<HTMLElement>('.selector-quest__divider');
  const viewButtons = Array.from(root?.querySelectorAll<HTMLButtonElement>('.selector-quest__views button') ?? []);
  const resetButton = root?.querySelector<HTMLButtonElement>('[data-reset-width]');
  const nudgeButtons = Array.from(root?.querySelectorAll<HTMLButtonElement>('[data-nudge]') ?? []);

  if (root && layout && story && divider) {
    const KEY = 'desn368-selector-quest-layout';
    const MIN = 260;
    const STEP = 24;
    const VIEWS = ['story', 'both', 'pen'];
    const state: { view: string; width: number | null } = { view: 'both', width: null };

    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
      if (VIEWS.includes(saved.view)) state.view = saved.view;
      if (typeof saved.width === 'number') state.width = saved.width;
    } catch {
      // Private windows can refuse storage; the page still works.
    }

    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {
        // See above.
      }
    };

    const maxWidth = () => Math.max(MIN, Math.round(layout.clientWidth * 0.7));
    const clamp = (w: number) => Math.min(Math.max(Math.round(w), MIN), maxWidth());

    const applyWidth = () => {
      if (state.width === null) layout.style.removeProperty('--sq-story-width');
      else layout.style.setProperty('--sq-story-width', `${clamp(state.width)}px`);
      const now = Math.round(story.getBoundingClientRect().width);
      divider.setAttribute('aria-valuemin', String(MIN));
      divider.setAttribute('aria-valuemax', String(maxWidth()));
      divider.setAttribute('aria-valuenow', String(now));
      divider.setAttribute('aria-valuetext', `Story panel ${now} pixels wide`);
    };

    const applyView = () => {
      root.dataset.view = state.view;
      viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === state.view)));
      if (state.view === 'both') applyWidth();
    };

    const resetWidth = () => {
      state.width = null;
      applyWidth();
      save();
    };

    viewButtons.forEach((b) =>
      b.addEventListener('click', () => {
        state.view = b.dataset.view || 'both';
        applyView();
        save();
      }),
    );
    resetButton?.addEventListener('click', resetWidth);

    const nudge = (delta: number) => {
      state.width = clamp(Math.round(story.getBoundingClientRect().width) + delta);
      applyWidth();
      save();
    };
    nudgeButtons.forEach((b) => b.addEventListener('click', () => nudge(Number(b.dataset.nudge) * STEP * 3)));

    // One pointer at a time. The drag ends on lostpointercapture, which follows pointerup, pointercancel,
    // and a capture lost to a context menu (Ctrl-click on a Mac), so the page cannot stay stuck mid-drag.
    let activePointer: number | null = null;
    divider.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || event.ctrlKey || activePointer !== null) return;
      event.preventDefault();
      divider.focus({ preventScroll: true });
      activePointer = event.pointerId;
      root.classList.add('is-resizing');
      const left = layout.getBoundingClientRect().left;
      const grab = event.clientX - divider.getBoundingClientRect().left;
      const move = (e: PointerEvent) => {
        if (e.pointerId !== activePointer) return;
        state.width = clamp(e.clientX - left - grab);
        applyWidth();
      };
      const stop = (e: PointerEvent) => {
        if (e.pointerId !== activePointer) return;
        activePointer = null;
        root.classList.remove('is-resizing');
        divider.removeEventListener('pointermove', move);
        ['pointerup', 'pointercancel', 'lostpointercapture'].forEach((t) => divider.removeEventListener(t, stop as EventListener));
        save();
      };
      divider.addEventListener('pointermove', move);
      ['pointerup', 'pointercancel', 'lostpointercapture'].forEach((t) => divider.addEventListener(t, stop as EventListener));
      try {
        divider.setPointerCapture(event.pointerId);
      } catch {
        // Without capture the drag still ends on pointerup.
      }
    });

    divider.addEventListener('dblclick', resetWidth);

    divider.addEventListener('keydown', (event) => {
      const current = Math.round(story.getBoundingClientRect().width);
      const step = event.shiftKey ? STEP * 3 : STEP;
      let next: number | null = null;
      if (event.key === 'ArrowLeft') next = current - step;
      else if (event.key === 'ArrowRight') next = current + step;
      else if (event.key === 'Home') next = MIN;
      else if (event.key === 'End') next = maxWidth();
      else if (event.key === 'Enter') {
        event.preventDefault();
        resetWidth();
        return;
      }
      if (next === null) return;
      event.preventDefault();
      state.width = clamp(next);
      applyWidth();
      save();
    });

    window.addEventListener('resize', () => {
      if (state.view === 'both') applyWidth();
    });

    // The tips close with Escape, a click elsewhere, focus leaving them, or a click into the Pen.
    const tips = root.querySelector<HTMLDetailsElement>('.selector-quest__tips');
    const closeTips = () => {
      if (tips?.open) tips.open = false;
    };
    document.addEventListener('click', (event) => {
      if (tips?.open && !tips.contains(event.target as Node)) closeTips();
    });
    tips?.addEventListener('focusout', (event) => {
      if (!tips.contains(event.relatedTarget as Node)) closeTips();
    });
    window.addEventListener('blur', closeTips);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && tips?.open) {
        const inside = tips.contains(document.activeElement);
        closeTips();
        if (inside) tips.querySelector('summary')?.focus();
      }
    });

    applyView();
  }
</script>
