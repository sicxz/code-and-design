---
import scene from '../../data/fall2026/opening-scene.json';
import CompanionName from './CompanionName.astro';
import { renderLessonMarkdown } from '../../lib/fall2026';
import '../../styles/fall2026-opening-scene.css';

const draft = scene.draft
  ? renderLessonMarkdown(`> **Draft for instructor review.** Waits on: ${scene.draft}`)
  : '';
const parts = (text: string) => text.split('{you}');
---
<dialog class="opening-scene" data-opening-scene data-storage-key={scene.storageKey} data-student-key={scene.studentNameKey} data-destination={scene.destination} aria-label={scene.label}>
  <svg class="opening-scene-grid" aria-hidden="true" focusable="false" width="100%" height="100%">
    <defs><pattern id="opening-scene-grid" width="8" height="8" patternUnits="userSpaceOnUse"><path d="M8 0H0V8" fill="none" /></pattern></defs>
    <rect width="100%" height="100%" fill="url(#opening-scene-grid)" />
  </svg>
  <div class="opening-scene-frame">
    <header class="opening-scene-byline">
      <span class="badge badge-story">Story</span>
      <span id="opening-scene-counter" data-opening-counter>1 of {scene.screens.length}</span>
    </header>
    <div class="opening-scene-body" data-opening-body>
      {scene.screens.map((screen, index) => (
        <section data-opening-screen hidden={index !== 0} data-opening-name={screen.nameForm} data-opening-label={screen.nextLabel}>
          <div class="opening-scene-text" tabindex="-1" data-opening-text aria-describedby="opening-scene-counter">
            {screen.headline && <p class="opening-scene-pixel">{screen.headline}</p>}
            {screen.paragraphs.map(paragraph => (
              <p>{parts(paragraph).map((part, position) => <>{position > 0 && <span data-student-echo>friend</span>}{part}</>)}</p>
            ))}
          </div>
          {screen.fiction && <p class="opening-scene-note">{scene.fiction}</p>}
          {screen.nameForm === 'companion' && <CompanionName />}
          {screen.nameForm === 'student' && (
            <div class="lesson-card" data-student-name>
              <form data-student-form novalidate>
                <label for="student-name">What I should call you</label>
                <input id="student-name" type="text" name="studentName" maxlength="24" autocomplete="off" spellcheck="false" aria-describedby="student-name-hint" />
                <p id="student-name-hint">Up to 24 letters. Spaces and hyphens are fine.</p>
                <button class="button" type="submit">Save my name</button>
              </form>
              <p>Your name: <strong data-student-current>not given yet</strong></p>
              <p role="status" data-student-status></p>
            </div>
          )}
          {screen.notes?.map(note => <p class="opening-scene-note">{note}</p>)}
        </section>
      ))}
    </div>
    <footer class="opening-scene-footer">
      <div class="opening-scene-actions">
        <button class="button" type="button" data-opening-next>{scene.controls.next}</button>
        <button class="button" type="button" data-opening-begin hidden>{scene.controls.begin}</button>
        <button class="button secondary" type="button" data-opening-skip>{scene.controls.skip}</button>
      </div>
      {draft && <div class="opening-scene-draft" set:html={draft} />}
    </footer>
  </div>
</dialog>
<script>import '../../scripts/fall2026-opening-scene.mjs';</script>
