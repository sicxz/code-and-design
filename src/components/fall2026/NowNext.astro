---
import { fall, getLessonModule, lessonHref } from '../../lib/fall2026';
import TypeBadge from './TypeBadge.astro';
interface Props { weekId: string }
const { weekId } = Astro.props;
const week = fall.weeks.find(week => week.id === weekId);
const courseModule = getLessonModule(weekId);
if (!week || !courseModule?.lessons.length) throw new Error(`No starting lesson for ${weekId}`);
const [first, ...next] = courseModule.lessons.slice(0, 3);
---
<section class="card now-next" aria-labelledby="now-next-title" data-now-next>
  <h2 id="now-next-title">Now and next</h2>
  <div class="now-row">
    <span class="eyebrow row-label">Start</span>
    <div><p class="meta">Week {week.number} / Lesson 1 of {courseModule.lessons.length}</p><h3>{first.title}</h3></div>
    <TypeBadge type={first.type} />
    <a class="button secondary" href={lessonHref(weekId, first.slug)} data-now-link>Open lesson <span aria-hidden="true">→</span></a>
  </div>
  <div class="next-row">
    <span class="eyebrow row-label">Next</span>
    <ol start="2">
      {next.map((lesson, index) => <li><TypeBadge type={lesson.type} /><a href={lessonHref(weekId, lesson.slug)} data-next-link><span class="lesson-number">{index + 2}</span> {lesson.title}</a></li>)}
    </ol>
  </div>
</section>
