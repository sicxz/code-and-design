---
import type { LessonType } from '../../lib/fall2026';
import TypeBadge from './TypeBadge.astro';
interface Props { href: string; label: string; type?: LessonType; note: string; number?: number; inFinish?: boolean }
const { href, label, type, note, number, inFinish = false } = Astro.props;
---
<section class="lesson-card next-up" aria-label="Next up">
  <p class="lesson-eyebrow">Next up</p>
  <h2>{inFinish ? <>{number && `${number} · `}{label}</> : <a href={href}>{number && `${number} · `}{label}<span class="next-arrow" aria-hidden="true">→</span></a>}</h2>
  {type && <TypeBadge type={type} />}
  <p class="next-note">{note}</p>
  <span class="print-only">{href}</span>
</section>
