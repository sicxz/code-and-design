---
import FallCourseLayout from '../../layouts/FallCourseLayout.astro';
import NowNext from '../../components/fall2026/NowNext.astro';
import WeekStations from '../../components/fall2026/WeekStations.astro';
import LessonAnatomy from '../../components/fall2026/LessonAnatomy.astro';
import { fall } from '../../lib/fall2026';
import '../../styles/fall2026-map.css';
---
<FallCourseLayout title="Course map" wide>
  <div data-course-map>
    <section class="card" aria-labelledby="map-page-title">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/1/">Course</a> / <span aria-current="page">Map</span></nav>
      <div class="color-bar" aria-hidden="true"></div>
      <h1 id="map-page-title">Course map</h1>
      <p class="intro-copy">Pick up where you left off or open any lesson. <a href="/1/#course-guide">How the course is organized</a></p>
    </section>
    <NowNext weekId="week-0" />
    <section class="card" aria-labelledby="map-title">
      <div class="map-intro">
        <div><h2 id="map-title">The map</h2><p>Follow the lessons in order. Return to any page when you need it.</p></div>
        <div class="tree-key" aria-label="Lesson status key">
          <span><span class="key-node" aria-hidden="true"></span>Not started</span>
          <span><span class="key-node complete" aria-hidden="true"></span>Complete</span>
          <span><span class="key-node resume" aria-hidden="true"></span>Your place</span>
        </div>
      </div>
      <div class="course-root"><span class="root-icon" aria-hidden="true">&lt;/&gt;</span><strong>{fall.courseCode} · {fall.title}</strong></div>
      <p class="eyebrow all-weeks-label">All weeks</p>
      <WeekStations />
    </section>
    <LessonAnatomy />
  </div>
</FallCourseLayout>
