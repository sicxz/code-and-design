---
import FallCourseLayout from '../../layouts/FallCourseLayout.astro';
import { readLesson } from '../../lib/fall2026';
import '../../styles/fall2026-syllabus.css';
import fileText from 'lucide-static/icons/file-text.svg?raw';
import user from 'lucide-static/icons/user.svg?raw';
import bookOpen from 'lucide-static/icons/book-open.svg?raw';
import lightbulb from 'lucide-static/icons/lightbulb.svg?raw';
import target from 'lucide-static/icons/target.svg?raw';
import chartPie from 'lucide-static/icons/chart-pie.svg?raw';
import calendarCheck from 'lucide-static/icons/calendar-check.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import packageOpen from 'lucide-static/icons/package-open.svg?raw';
import hammer from 'lucide-static/icons/hammer.svg?raw';
import layers from 'lucide-static/icons/layers.svg?raw';
import scrollText from 'lucide-static/icons/scroll-text.svg?raw';
import code from 'lucide-static/icons/code.svg?raw';
import handshake from 'lucide-static/icons/handshake.svg?raw';
import send from 'lucide-static/icons/send.svg?raw';

const sectionIcons: Record<string, string> = {
  'course-information': fileText,
  'instructor': user,
  'course-description': bookOpen,
  'what-you-will-learn': lightbulb,
  'learning-objectives': target,
  'grading-breakdown': chartPie,
  'attendance': calendarCheck,
  'late-work': clock,
  'what-the-course-provides': packageOpen,
  'the-work': hammer,
  'three-places': layers,
  'the-story-and-your-place-in-it': scrollText,
  'source-fluency-and-ai': code,
  'studio-responsibilities': handshake,
  'deliver-cleanly': send,
};
const decorativeIcon = (svg: string) => svg
  .replace(/<!--[^]*?-->/g, '')
  .trim()
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');

const [header, ...parts] = readLesson('syllabus.md').split(/(?=<h2>)/);
const sections = parts.map(part => {
  const [, heading, content] = part.match(/^<h2>(.*?)<\/h2>([\s\S]*)$/)!;
  const slug = heading.toLowerCase().replace(/\s+/g, '-');
  let body = content;
  if (slug === 'learning-objectives') {
    const [intro, ...columns] = body.split(/(?=<h3>)/);
    body = intro + '<div class="objective-columns">' + columns.map(column => {
      const plo = column.match(/<h3>(PLO-\d+)/)![1];
      return `<div data-plo="${plo}">${column}</div>`;
    }).join('') + '</div>';
  }
  if (slug === 'grading-breakdown') {
    let tableIndex = 0;
    body = body.replace(/<table>[\s\S]*?<\/table>/g, table => {
      if (tableIndex++ === 0) return table;
      // Explicit roles preserve table semantics when CSS lays out the cells.
      return table.replace('<table>', '<table class="grade-scale" role="table">')
        .replace('<thead>', '<thead role="rowgroup">')
        .replace('<tbody>', '<tbody role="rowgroup">')
        .replace(/<tr>/g, '<tr role="row">')
        .replace(/<th>/g, '<th role="columnheader" scope="col">')
        .replace(/<td>/g, '<td role="cell">');
    });
  }
  return { slug, heading, body };
});
---
<FallCourseLayout title="Syllabus">
  <p class="breadcrumb"><a href="/1/">Course</a> / Syllabus</p>
  <div data-syllabus-page>
    <header data-syllabus-header set:html={header} />
    {sections.map(({ slug, heading, body }) => (
      <section
        class:list={['card syllabus-card', {
          'syllabus-facts': ['course-information', 'instructor'].includes(slug),
          'syllabus-objectives': slug === 'learning-objectives',
          'syllabus-grading': slug === 'grading-breakdown',
          'syllabus-policy': ['attendance', 'late-work'].includes(slug),
        }]}
        data-syllabus-section={slug}
        aria-labelledby={slug}
      >
        <h2 id={slug}>
          <Fragment set:html={decorativeIcon(sectionIcons[slug])} />
          <span set:html={heading} />
        </h2>
        <Fragment set:html={body} />
      </section>
    ))}
  </div>
</FallCourseLayout>
