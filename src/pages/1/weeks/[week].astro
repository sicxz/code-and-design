---
import FallCourseLayout from '../../../layouts/FallCourseLayout.astro';
import { fall, displayDate, readLesson, getLessonModule, isWeekReleased, opensLabel } from '../../../lib/fall2026';
import ModuleIndex from '../../../components/fall2026/ModuleIndex.astro';
import lessonStyles from '../../../styles/fall2026-lessons.css?inline';
export function getStaticPaths(){return fall.weeks.map(week=>({params:{week:week.id},props:{week}}));}
const { week } = Astro.props;
const index = fall.weeks.findIndex(w=>w.id===week.id);
const courseModule = getLessonModule(week.id);
const released = isWeekReleased(week.id);
const nextWeek = fall.weeks[index + 1];
const week0Submissions = courseModule?.lessons.flatMap(lesson => lesson.submission ? [lesson.submission] : []) ?? [];
---
<FallCourseLayout title={week.title} wide>
  <p class="breadcrumb"><a href="/1/">Course</a> / {week.number===0?'Opening studio':`Week ${week.number}`}</p>
  {released && week.id === 'week-1' && <p><a href="/1/weeks/week-1/walkthrough/">Open the Monday / Wednesday walkthrough · instructor review</a></p>}
  <div class="meta-strip"><span>{week.sessions.map(s=>displayDate(s.date)).join(' + ')}</span>{week.sessions.some(s=>s.mode==='async') && <strong>October 28 is independent practice</strong>}</div>
  {released ? <div class="lesson-grid">{courseModule ? <><style is:inline set:html={lessonStyles} /><ModuleIndex week={week} module={courseModule} /></> : <article class="prose" set:html={readLesson(week.lesson)} />}<aside class="lesson-sidebar">{week.id === 'week-0' ? <><h2>Four Canvas submissions</h2><ul>{week0Submissions.map(item => <li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a></li>)}</ul><p class="muted">Open each assignment in Canvas to check its due date and submission status.</p></> : <><h2>This week’s evidence</h2><ul>{week.assignmentIds.map(id=>{const a=fall.assignments.find(a=>a.id===id&&a.inCanvas);return a&&<li><a href={`/1/assignments/${a.id}/`}>{a.title}</a><br/><span class="muted">Due {displayDate(a.dueDate)}</span></li>})}</ul></>}<h2>Before you move on</h2><ul>{week.outcomes.map(outcome=><li>{outcome}</li>)}</ul><a href="/1/syllabus/#source-fluency-and-ai">Source checks and recovery</a></aside></div> : <div class="prose" data-week-closed><h1>Week {week.number} · {week.title}</h1><p class="page-intro">Opens {opensLabel(week.startDate)}.</p></div>}
  <nav class="button-row" aria-label="Studio sequence">{index>0&&isWeekReleased(fall.weeks[index-1].id)&&<a class="button secondary" href={`/1/weeks/${fall.weeks[index-1].id}/`}>Previous studio</a>}{nextWeek && isWeekReleased(nextWeek.id) && <a class="button" href={`/1/weeks/${nextWeek.id}/`}>Next studio</a>}<a class="button secondary" href="/1/schedule/">Full schedule</a></nav>
</FallCourseLayout>
