---
import FallCourseLayout from '../../layouts/FallCourseLayout.astro';
import EssentialsStrip from '../../components/fall2026/EssentialsStrip.astro';
import RouteTimeline from '../../components/fall2026/RouteTimeline.astro';
import StoryCard from '../../components/fall2026/StoryCard.astro';
import OpeningScene from '../../components/fall2026/OpeningScene.astro';
import { fall, lessonModules, readLesson } from '../../lib/fall2026';
import '../../styles/fall2026-home.css';

// Both sections stay authored together; split only after Markdown rendering.
const content = readLesson('welcome.md');
const pledgeStart = content.indexOf('<h2>Student pledge</h2>');
if (pledgeStart < 0) throw new Error('Welcome content needs its Student pledge heading.');
const welcome = content.slice(0, pledgeStart).replace('<h2>', '<h1 id="welcome-title">').replace('</h2>', '</h1>');
const pledge = content.slice(pledgeStart).replace('<h2>', '<h2 id="pledge-title">');
const meetingDays = fall.schedule.days.split(' / ').map(day => day.slice(0, 3)).join(' and ');
const meetingTime = fall.schedule.time.replace('–', ' to ').replace(' p.m.', '');
---
<FallCourseLayout title="Course home" wide>
  <div data-course-home>
    <div class="schedule-strip"><span>{fall.weeks.length} weeks</span><span>{meetingDays} {meetingTime}</span><span>Canvas holds the dates</span></div>
    <section class="card card-accent welcome" aria-labelledby="welcome-title">
      <p class="eyebrow">Start with the source</p>
      <Fragment set:html={welcome} />
      <div class="button-row"><a class="button" href="/1/weeks/week-0/" data-opening-start>Start here: Week 0 <span aria-hidden="true">→</span></a><a class="button secondary" href="/1/syllabus/">Read the syllabus</a></div>
    </section>
    <section class="card pledge-card" aria-labelledby="pledge-title">
      <p class="eyebrow">Student pledge · Required</p>
      <Fragment set:html={pledge} />
    </section>
    <EssentialsStrip />
    <RouteTimeline weeks={fall.weeks} registry={lessonModules} />
    <StoryCard />
    <OpeningScene />
  </div>
</FallCourseLayout>
