---
import FallCourseLayout from '../../layouts/FallCourseLayout.astro';
import { fall, displayDate, displayTime, groupLabel } from '../../lib/fall2026';
---
<FallCourseLayout title="Quarter schedule">
  <p class="breadcrumb"><a href="/1/">Course</a> / Schedule</p><h1>A quarter of building.</h1><p class="page-intro">Monday and Wednesday, 1–3:30 p.m. Every session has a focus, time to practice, and a way to check your understanding.</p>
  <div class="callout"><p><strong>October 28:</strong> supported independent practice. <strong>November 11 and 25:</strong> no classes. <strong>December 9:</strong> final presentations, 1–3 p.m.</p><p>Dates use Pacific time. Submission deadlines and project details are listed with each assignment.</p></div>
  <div class="table-wrap"><table><caption>Fall 2026 studio meetings</caption><thead><tr><th>Date</th><th>Studio</th><th>Meeting focus</th><th>Work due</th></tr></thead><tbody>{fall.weeks.flatMap(week=>week.sessions.map(session=><tr><th scope="row">{displayDate(session.date)}</th><td><a href={`/1/weeks/${week.id}/`}>{week.title}</a></td><td>{session.title}{session.mode==='async' && <strong> · Independent practice</strong>}</td><td>{fall.assignments.filter(a=>a.dueDate===session.date).map(a=><div><a href={`/1/assignments/${a.id}/`}>{a.title}</a></div>)}</td></tr>))}<tr><th scope="row">Dec 9</th><td>Final presentations</td><td>1–3 p.m. · Share the portfolio and explain your source</td><td><a href="/1/assignments/">Final portfolio</a></td></tr></tbody></table></div>
  <h2>Weekly submission dates</h2><p>Some submissions fall between studio meetings. This list includes every deadline.</p><div class="table-wrap"><table><thead><tr><th>Due</th><th>Assignment</th><th>Category</th></tr></thead><tbody>{[...fall.assignments].sort((a,b)=>a.dueDate.localeCompare(b.dueDate)).map(a=><tr><td>{displayDate(a.dueDate)} · {displayTime(a.dueTime)}</td><td><a href={`/1/assignments/${a.id}/`}>{a.title}</a></td><td>{groupLabel(a.group)}</td></tr>)}</tbody></table></div>
</FallCourseLayout>
